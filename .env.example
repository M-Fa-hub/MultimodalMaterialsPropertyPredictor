# Materials Project API key (optional; demo dataset works without it)
# Get one at https://next-gen.materialsproject.org/api
MP_API_KEY=

# Runtime
MATERIALS_AI_DATA_DIR=data
MATERIALS_AI_OUTPUT_DIR=outputs
MATERIALS_AI_SEED=42
MATERIALS_AI_LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=sqlite:///outputs/mlflow/mlflow.db
MLFLOW_EXPERIMENT_NAME=materials-bandgap
MLFLOW_DISABLE_AGENT_HINT=1

# API
API_HOST=0.0.0.0
API_PORT=8000
MODEL_CHECKPOINT=outputs/models/multimodal_best.pt
